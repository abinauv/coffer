{
  "name": "coffer",
  "version": "0.1.0",
  "description": "Free, open-source accounting and ERP software for small businesses in India: GST invoicing, double-entry books and inventory, offline and encrypted on your own computer.",
  "keywords": [
    "accounting",
    "accounting-software",
    "erp",
    "gst",
    "gst-invoice",
    "india",
    "msme",
    "sme",
    "small-business",
    "invoicing",
    "billing",
    "bookkeeping",
    "double-entry-accounting",
    "inventory-management",
    "tally-alternative",
    "local-first",
    "offline-first",
    "electron"
  ],
  "homepage": "https://github.com/abinauv/coffer#readme",
  "bugs": {
    "url": "https://github.com/abinauv/coffer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abinauv/coffer.git"
  },
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/native-modules.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "native:check": "node scripts/native-modules.mjs",
    "native:verify": "node scripts/native-modules.mjs --electron",
    "checksums": "node scripts/checksums.mjs",
    "icon": "node scripts/generate-icon.mjs",
    "brand:assets": "electron scripts/render-brand-assets.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutate": "node scripts/mutate.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "node --test scripts/mutate.test.mjs scripts/packaging.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:scripts",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "decimal.js": "10.6.0",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "kysely": "0.29.5",
    "libsodium-wrappers": "0.8.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.1",
    "electron": "43.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "happy-dom": "20.14.3",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "author": "The Coffer contributors <abinauv@users.noreply.github.com>"
}
