{
  "$comment": "Golden fixtures for fiscal years. The April-to-March rule is one entry here, not an assumption anywhere. Changing a year boundary, a label format, or the periods inside a year must fail a test here.",
  "rules": [
    { "id": "april-march", "startMonth": 4, "startDay": 1, "exported": "aprilToMarch" },
    { "id": "january-december", "startMonth": 1, "startDay": 1, "exported": "januaryToDecember" },
    {
      "id": "april-sixth",
      "startMonth": 4,
      "startDay": 6,
      "why": "a year that does not start on the 1st — the UK personal tax year"
    },
    {
      "id": "july-june",
      "startMonth": 7,
      "startDay": 1,
      "why": "Australia, and a second two-calendar-year shape"
    }
  ],
  "dates": [
    {
      "rule": "april-march",
      "date": "2026-04-01",
      "startYear": 2026,
      "label": "2026-27",
      "startDate": "2026-04-01",
      "endDate": "2027-03-31",
      "why": "the first day of a fiscal year belongs to it, not the one before"
    },
    {
      "rule": "april-march",
      "date": "2026-03-31",
      "startYear": 2025,
      "label": "2025-26",
      "startDate": "2025-04-01",
      "endDate": "2026-03-31",
      "why": "the last day. A date in 2026 whose fiscal year is labelled 2025-26"
    },
    {
      "rule": "april-march",
      "date": "2026-01-01",
      "startYear": 2025,
      "label": "2025-26",
      "startDate": "2025-04-01",
      "endDate": "2026-03-31",
      "why": "January is in the previous fiscal year"
    },
    {
      "rule": "april-march",
      "date": "2026-12-31",
      "startYear": 2026,
      "label": "2026-27",
      "startDate": "2026-04-01",
      "endDate": "2027-03-31",
      "why": "December is in the current one"
    },
    {
      "rule": "april-march",
      "date": "2028-02-29",
      "startYear": 2027,
      "label": "2027-28",
      "startDate": "2027-04-01",
      "endDate": "2028-03-31",
      "why": "the leap day falls in an April-to-March year that started the previous calendar year"
    },
    {
      "rule": "april-march",
      "date": "2000-03-31",
      "startYear": 1999,
      "label": "1999-00",
      "startDate": "1999-04-01",
      "endDate": "2000-03-31",
      "why": "the century roll: the second half of the label wraps to 00"
    },
    {
      "rule": "april-march",
      "date": "2099-04-01",
      "startYear": 2099,
      "label": "2099-00",
      "startDate": "2099-04-01",
      "endDate": "2100-03-31",
      "why": "and again, with 2100 not a leap year"
    },
    {
      "rule": "january-december",
      "date": "2026-01-01",
      "startYear": 2026,
      "label": "2026",
      "startDate": "2026-01-01",
      "endDate": "2026-12-31",
      "why": "a calendar-year rule is labelled with one year, not two"
    },
    {
      "rule": "january-december",
      "date": "2026-12-31",
      "startYear": 2026,
      "label": "2026",
      "startDate": "2026-01-01",
      "endDate": "2026-12-31",
      "why": "the last day"
    },
    {
      "rule": "january-december",
      "date": "2028-02-29",
      "startYear": 2028,
      "label": "2028",
      "startDate": "2028-01-01",
      "endDate": "2028-12-31",
      "why": "the leap day, in a year that is 366 days long"
    },
    {
      "rule": "april-sixth",
      "date": "2026-04-05",
      "startYear": 2025,
      "label": "2025-26",
      "startDate": "2025-04-06",
      "endDate": "2026-04-05",
      "why": "the day before the start belongs to the previous year — the start day matters, not just the month"
    },
    {
      "rule": "april-sixth",
      "date": "2026-04-06",
      "startYear": 2026,
      "label": "2026-27",
      "startDate": "2026-04-06",
      "endDate": "2027-04-05",
      "why": "and the start day itself begins the new one"
    },
    {
      "rule": "july-june",
      "date": "2026-06-30",
      "startYear": 2025,
      "label": "2025-26",
      "startDate": "2025-07-01",
      "endDate": "2026-06-30",
      "why": "last day"
    },
    {
      "rule": "july-june",
      "date": "2026-07-01",
      "startYear": 2026,
      "label": "2026-27",
      "startDate": "2026-07-01",
      "endDate": "2027-06-30",
      "why": "first day"
    }
  ],
