        { "index": 12, "label": "Dec 2028", "startDate": "2028-12-01", "endDate": "2028-12-31" }
      ]
    },
    {
      "rule": "january-december",
      "startYear": 2026,
      "granularity": "quarter",
      "expected": [
        { "index": 1, "label": "Q1 2026", "startDate": "2026-01-01", "endDate": "2026-03-31" },
        { "index": 2, "label": "Q2 2026", "startDate": "2026-04-01", "endDate": "2026-06-30" },
        { "index": 3, "label": "Q3 2026", "startDate": "2026-07-01", "endDate": "2026-09-30" },
        { "index": 4, "label": "Q4 2026", "startDate": "2026-10-01", "endDate": "2026-12-31" }
      ]
    },
    {
      "rule": "april-sixth",
      "startYear": 2025,
      "granularity": "quarter",
      "expected": [
        { "index": 1, "label": "Q1 2025-26", "startDate": "2025-04-06", "endDate": "2025-07-05" },
        { "index": 2, "label": "Q2 2025-26", "startDate": "2025-07-06", "endDate": "2025-10-05" },
        { "index": 3, "label": "Q3 2025-26", "startDate": "2025-10-06", "endDate": "2026-01-05" },
        { "index": 4, "label": "Q4 2025-26", "startDate": "2026-01-06", "endDate": "2026-04-05" }
      ],
      "why": "periods run from the 6th to the 5th, and the last one still ends on the fiscal year's last day"
    }
