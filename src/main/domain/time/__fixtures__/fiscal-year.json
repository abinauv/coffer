        { "index": 3, "label": "Q3 2027-28", "startDate": "2027-10-01", "endDate": "2027-12-31" },
        { "index": 4, "label": "Q4 2027-28", "startDate": "2028-01-01", "endDate": "2028-03-31" }
      ],
      "why": "Q1 is the first quarter of the fiscal year, not of the calendar year"
